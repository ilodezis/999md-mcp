# Password typed once on the consent page when connecting Claude.ai.
PASSWORD=
# Token signing key. Rotating it revokes every issued token (Claude must reconnect).
# python -c "import secrets; print(secrets.token_urlsafe(48))"
TOKEN_SECRET=
# OAuth client, entered in the connector's advanced settings on Claude.ai.
CLIENT_ID=999md-claude-connector
CLIENT_SECRET=
# Comma-separated; default is Claude.ai's callback.
# REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback
SITE_LANG=ru
